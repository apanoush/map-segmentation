# Data: user-provided inputs, trained models and generated outputs are large
/data/*
!/data/.gitkeep
/model/*
!/model/.gitkeep
!/model/README.md
/results/*
!/results/.gitkeep

# Virtual environments / tooling
.venv/
venv/
.ruff_cache/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Local clone of upstream mmsegmentation (the Docker image clones its own)
/mmsegmentation/

/old/*

# Large test artifacts (the test suite itself is tracked)
/tests/fixtures/*.npy
/tests/fixtures/*.pth
/tests/fixtures/*.tiff

# Local secrets / env
.env
.env.*
